{
  "_comment": "任何 OpenAI 兼容的 /chat/completions 接口都可以。api_key_env 只写环境变量名，绝不写真实密钥。model 名称请按各平台当前文档填写。",
  "models": [
    {"name": "gpt",      "model": "${填写模型名}", "base_url": "https://api.openai.com/v1",                       "api_key_env": "OPENAI_API_KEY"},
    {"name": "deepseek", "model": "${填写模型名}", "base_url": "https://api.deepseek.com/v1",                     "api_key_env": "DEEPSEEK_API_KEY"},
    {"name": "qwen",     "model": "${填写模型名}", "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1", "api_key_env": "DASHSCOPE_API_KEY"},
    {"name": "local",    "model": "${填写模型名}", "base_url": "http://localhost:11434/v1",                       "api_key_env": "OLLAMA_API_KEY"}
  ]
}
