# Copy to server/.env (never commit it).
ALLOWED_ORIGINS=https://cv.leozto.sbs,https://mcbench.pages.dev
ADMIN_TOKEN=change-me-long-random          # openssl rand -hex 32
SECRET_KEY=                                # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TRUST_PROXY=1                              # behind Cloudflare Tunnel: trust CF-Connecting-IP
ALLOW_SCRIPTED=0
ALLOW_PRIVATE_URLS=0
MAX_QUEUE=20
SUBMIT_PER_HOUR=3
VOTE_PER_MIN=10
VOTE_PER_DAY=300
JOB_TIMEOUT=7200
EVAL_HARD_SET=hard-v1.1
EVAL_HARD_SPLIT=test
EVAL_CORE_SET=v1.0
EVAL_LIMIT=0
# backup (scripts/backup.sh)
BACKUP_TARGET=github                       # github | r2 | none
BACKUP_GIT_REPO=git@github.com:<you>/mcbench-backups.git
R2_BUCKET=mcbench-backups
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2 credentials via AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the host environment
